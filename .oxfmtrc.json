{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": ["types/database.types.ts"],
  "printWidth": 120,
  "useTabs": false,
  "tabWidth": 2,
  "trailingComma": "all",
  "semi": true,
  "singleQuote": true,
  "sortImports": true,
  "sortPackageJson": true,
  "sortTailwindcss": true,
  "endOfLine": "lf",
  "objectWrap": "preserve",
  "singleAttributePerLine": true
}
